  .sn-chart-body { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px; }
  .sn-y-axis { height: 74px; position: relative; padding-bottom: 2px; font-size: .625rem; font-weight: 700; }
  .sn-y-axis-sizer { display: flex; width: max-content; visibility: hidden; flex-direction: column; }
  .sn-y-axis-value { position: absolute; right: 0; line-height: 1; }
  .sn-y-axis-max { top: 0; }
  .sn-y-axis-min { transform: translateY(50%); }
  .sn-section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 5px; }
  .sn-section-title { font-size: .8125rem; font-weight: 800; text-transform: uppercase; letter-spacing: .7px; }
  .sn-section-note { font-size: .625rem; font-weight: 600; }
