  .sn-summary .sn-kpi-value { font-size: 2.25rem; }
  .sn-kicker { display: block; font-size: .8125rem; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; }
  .sn-total { display: block; font-size: 3.375rem; font-weight: 800; line-height: .95; letter-spacing: -2px; }
  .sn-kpis { display: flex; gap: 10px; }
