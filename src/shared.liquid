  .sn-fill { height: 100%; background: currentColor; }
  .sn-hour, .sn-day { text-align: center; font-size: .75rem; font-weight: 700; }
  .sn-column-head { display: grid; grid-template-columns: 84px 1fr 48px 54px; gap: 6px; font-size: .5625rem; font-weight: 800; text-transform: uppercase; }
  .sn-column-head span { text-align: center; }
  .sn-footer-status { display: flex; align-items: center; justify-content: center; gap: 5px; max-width: 460px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .6875rem; font-weight: 800; text-align: center; }
  .sn-footer-status > span:last-child { overflow: hidden; text-overflow: ellipsis; }
  .sn-status-icon { display: inline-flex; width: 14px; height: 14px; flex: 0 0 14px; align-items: center; justify-content: center; border: 1.5px solid currentColor; border-radius: 50%; font-family: sans-serif; font-size: .625rem; font-weight: 900; line-height: 1; }
