  <div class="layout sniffnet">
    <div class="sn-header">
      <div><span class="sn-kicker">All-time</span><span class="sn-compact-total">{{ lifetime_formatted }}</span></div>
      <div class="sn-kpis">
        <div class="sn-kpi"><span class="sn-kpi-value">{{ rolling_24h_formatted }}</span><span class="sn-kpi-label">24h</span></div>
        <div class="sn-kpi"><span class="sn-kpi-value">{{ latest_hour_formatted }}</span><span class="sn-kpi-label">Hour</span></div>
      </div>
    </div>
    <div class="sn-chart">
      <div class="sn-section-head"><span class="sn-section-title">Hourly downloads</span></div>
      <div class="sn-bars">{% for point in hourly %}<div class="sn-bar"><span class="sn-bar-fill" style="height: {{ point.height }}%"></span></div>{% endfor %}</div>
      <div class="sn-axis"><span>{{ axis_compact | first }}</span><span>{{ axis_compact | last }}</span></div>
    </div>
  </div>
  <div class="title_bar sniffnet"><span class="title">Sniffnet downloads</span></div>
