  <style>.sn-y-axis-min { bottom: {{ chart_min_height }}%; }</style>
  <div class="layout sniffnet">
    <div class="sn-summary">
      <div class="sn-kpi">
        <span class="sn-kpi-value">{{ lifetime_formatted }}</span>
        <span class="sn-kpi-label">All-time downloads</span>
      </div>
      <div class="sn-kpi">
        <span class="sn-kpi-value">{{ rolling_24h_formatted }}</span>
        <span class="sn-kpi-label">Rolling 24h</span>
      </div>
      <div class="sn-kpi">
        <span class="sn-kpi-value">{{ latest_hour_formatted }}</span>
        <span class="sn-kpi-label">Latest hour</span>
      </div>
    </div>

    <div class="sn-chart">
      <div class="sn-chart-body">
        <div class="sn-y-axis">
          <span class="sn-y-axis-sizer" aria-hidden="true"><span>{{ chart_max_formatted }}</span><span>{{ chart_min_formatted }}</span></span>
          <span class="sn-y-axis-value sn-y-axis-max">{{ chart_max_formatted }}</span>
          {% if show_chart_min %}<span class="sn-y-axis-value sn-y-axis-min">{{ chart_min_formatted }}</span>{% endif %}
        </div>
        <div>
          <div class="sn-bars">
            {% for point in hourly %}
              <div class="sn-bar" title="{{ point.formatted }} downloads{% if point.has_errors %}; incomplete due to source error{% endif %}">
                <span class="sn-bar-fill{% if point.has_errors %} sn-bar-fill--error{% endif %}" style="height: {{ point.height }}%"></span>
              </div>
            {% endfor %}
          </div>
          <div class="sn-axis sn-axis--hours">
            {% for point in hourly %}<span>{{ point.axis_label }}</span>{% endfor %}
          </div>
        </div>
      </div>
    </div>

    <div class="sn-grid">
      <div class="sn-panel">
        <div class="sn-column-head"><span></span><span>24h share</span><span>24h</span><span>hour</span></div>
        {% for row in source_rows %}
          <div class="sn-row">
            <span class="sn-name">{{ row.name }}</span>
            <div class="sn-track"><div class="sn-fill" style="width: {{ row.width }}%"></div></div>
            <span class="sn-day">{{ row.formatted }}</span>
            <span class="sn-hour">{{ row.hourly_formatted }}</span>
          </div>
        {% endfor %}
      </div>
      <div class="sn-panel">
        <div class="sn-column-head"><span></span><span>24h share</span><span>24h</span><span>hour</span></div>
        {% for row in platform_rows %}
          <div class="sn-row">
            <span class="sn-name">{{ row.name }}</span>
            <div class="sn-track"><div class="sn-fill" style="width: {{ row.width }}%"></div></div>
            <span class="sn-day">{{ row.formatted }}</span>
            <span class="sn-hour">{{ row.hourly_formatted }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="title_bar sniffnet sniffnet--status">
    <span class="title">Sniffnet downloads</span>
    <span class="sn-footer-status">
      {% if has_warnings %}
        <span class="sn-status-icon">!</span><span>{{ warning_status }}</span>
      {% endif %}
    </span>
    <span class="instance">{{ updated_at }}</span>
  </div>
